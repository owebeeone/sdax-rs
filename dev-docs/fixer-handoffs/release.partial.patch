+        publish_stub.write_text(
+            textwrap.dedent(
+                """\
+                #!/usr/bin/env sh
+                printf '%s\n' "$*" >> "$PWD/publish_log.txt"
+                """
+            ),
+            encoding="utf-8",
+        )
+        (repo / "publish_log.txt").write_text("", encoding="utf-8")
+        publish_stub_path = publish_stub.as_posix()
+        os.chmod(publish_stub, 0o755)
+
+        result = run_script(
+            repo,
+            [
+                "publish-plan",
+                "v0.1.0",
+                "--expected-sha",
+                git(repo, "rev-parse", "HEAD").stdout.strip(),
+                "--run-commands",
+                "--publish-command",
+                publish_stub_path,
+            ],
+            env={"SDAX_RELEASE_REGISTRY_FIXTURE": str(fixture)},
+        )
+        self.assertEqual(result.returncode, 0, msg=result.stderr)
+        log = (repo / "publish_log.txt").read_text(encoding="utf-8").splitlines()
+        self.assertEqual(log[0], "publish -p sdax --locked")
+        self.assertEqual(log[1], "publish -p sdax-tokio --locked")

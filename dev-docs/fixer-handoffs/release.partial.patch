+#!/usr/bin/env python3
+"""Release-selection regression tests.
+
+These tests keep all checks local, using temporary git repositories and a mocked
+crates.io payload fixture. No network access and no cargo publication calls hit the
+real environment.
+"""
+
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import textwrap
+import unittest
+from pathlib import Path
+
+
+SCRIPT = Path(__file__).resolve().parent / "release_selection.py"
+
+
+def git(repo: Path, *args: str, env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
+    command = ["git", "-C", str(repo), *args]
+    merged_env = os.environ.copy()
+    merged_env.setdefault("GIT_AUTHOR_NAME", "sdax-test")
+    merged_env.setdefault("GIT_AUTHOR_EMAIL", "sdax-test@example.com")
+    merged_env.setdefault("GIT_COMMITTER_NAME", "sdax-test")
+    merged_env.setdefault("GIT_COMMITTER_EMAIL", "sdax-test@example.com")
+    if env:
+        merged_env.update(env)
+    return subprocess.run(
+        command,
+        text=True,
+        capture_output=True,
+        env=merged_env,
+        check=False,
+    )
+
+
+def run_script(
+    repo: Path,
+    args: list[str],
+    *,
+    env: dict[str, str] | None = None,
+) -> subprocess.CompletedProcess[str]:
+    merged = os.environ.copy()
+    if env:
+        merged.update(env)
+    return subprocess.run(
+        [sys.executable, str(SCRIPT), *args],
+        cwd=str(repo),
+        text=True,
+        capture_output=True,
+        env=merged,
+        check=False,
+    )
+
+
+def parse_key_value_blob(blob: str) -> dict[str, str]:
+    out: dict[str, str] = {}
+    for line in blob.splitlines():
+        if "=" not in line:
+            continue
+        key, value = line.split("=", 1)
+        out[key] = value
+    return out
+
+
+class ReleaseSelectionTestCase(unittest.TestCase):
+    def write_repo(self, *, version: str = "0.1.0") -> Path:
+        repo = Path(tempfile.mkdtemp(prefix="sdax-release-"))
+        cargo_toml = textwrap.dedent(
+            f"""\
+            [workspace]
+            members = [
+                "crates/sdax",
+                "crates/sdax-tokio",
+            ]
+
+            [workspace.package]
+            version = "{version}"
+            rust-version = "1.75"
+            """
+        )
+        sdax = textwrap.dedent(
+            f"""\
+            [package]
+            name = "sdax"
+            version = "{version}"
+            edition = "2021"
+            """
+        )
+        sdax_tokio = textwrap.dedent(
+            f"""\
+            [package]
+            name = "sdax-tokio"
+            version = "{version}"
+            edition = "2021"
+
+            [dependencies]
+            sdax = {{ path = "../sdax", version = "{version}" }}
+            """
+        )
+        (repo / "Cargo.toml").write_text(cargo_toml, encoding="utf-8")
+        (repo / "crates").mkdir()
+        (repo / "crates" / "sdax").mkdir(parents=True)
+        (repo / "crates/sdax/Cargo.toml").write_text(sdax, encoding="utf-8")
+        (repo / "crates/sdax-tokio").mkdir(parents=True)
+        (repo / "crates/sdax-tokio/Cargo.toml").write_text(sdax_tokio, encoding="utf-8")
+
+        git(repo, "init")
+        git(repo, "add", "Cargo.toml", "crates/sdax/Cargo.toml", "crates/sdax-tokio/Cargo.toml")
+        git(repo, "commit", "-m", f"release fixture {version}")
+        return repo
+
+    def tag(self, repo: Path, name: str, *, annotated: bool = False) -> str:
+        if annotated:
+            result = git(repo, "tag", "-a", name, "-m", f"{name} release")
+        else:
+            result = git(repo, "tag", name)
+        if result.returncode != 0:
+            self.fail(result.stderr)
+        return repo / ".git" and repo
+
+    def assert_success(self, result: subprocess.CompletedProcess[str], *, context: str) -> dict[str, str]:
+        if result.returncode != 0:
+            self.fail(f"{context}: rc={result.returncode} stdout={result.stdout!r} stderr={result.stderr!r}")
+        return parse_key_value_blob(result.stdout)
+
+    def mk_registry_fixture(self, repo: Path, values: dict[str, object]) -> Path:
+        fixture = repo / "registry.json"
+        fixture.write_text(json.dumps(values), encoding="utf-8")
+        return fixture
+
+    def test_malformed_tag_rejected(self) -> None:
+        repo = self.write_repo()
+        result = run_script(repo, ["resolve", "bad-tag"])
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("must look like vX.Y.Z", result.stderr)
+
+    def test_unknown_tag_rejected(self) -> None:
+        repo = self.write_repo()
+        result = run_script(repo, ["resolve", "v9.9.9"])
+        self.assertEqual(result.returncode, 2)
+        self.assertIn("does not resolve to a tag", result.stderr)
+
+    def test_lightweight_and_annotated_tags_resolve(self) -> None:
+        repo = self.write_repo()
+        git(repo, "tag", "v0.1.0")
+        head_commit = git(repo, "rev-parse", "HEAD").stdout.strip()
+
+        # add an annotated tag to the same commit
+        git(repo, "tag", "-d", "v0.1.0")
+        git(repo, "tag", "-a", "v0.1.0", "-m", "annotated")
+        result = run_script(repo, ["resolve", "v0.1.0"])
+        info = self.assert_success(result, context="annotated tag")
+        self.assertEqual(info["release_sha"], head_commit)
+
+    def test_dispatch_branch_newer_than_taged_release_uses_tag_commit(self) -> None:
+        repo = self.write_repo(version="0.2.0")
+        git(repo, "tag", "v0.2.0")
+        tagged_commit = git(repo, "rev-parse", "HEAD").stdout.strip()
+
+        (repo / "README.md").write_text("newer-commit\n", encoding="utf-8")
+        git(repo, "add", "README.md")
+        git(repo, "commit", "-m", "advance branch")
+
+        result = run_script(repo, ["resolve", "v0.2.0"])
+        info = self.assert_success(result, context="tag commit selection")
+        self.assertEqual(info["release_sha"], tagged_commit)
+
+    def test_tag_movement_is_refused(self) -> None:
+        repo = self.write_repo(version="0.3.0")
+        git(repo, "tag", "v0.3.0")
+        first_sha = git(repo, "rev-parse", "HEAD").stdout.strip()
+
+        result = run_script(repo, ["--format", "json", "resolve", "v0.3.0"])
+        self.assertEqual(result.returncode, 0)
+        first = json.loads(result.stdout.strip())
+        self.assertEqual(first["release_sha"], first_sha)
+
+        (repo / "README.md").write_text("second\n", encoding="utf-8")
+        git(repo, "add", "README.md")
+        git(repo, "commit", "-m", "second commit")
+        git(repo, "tag", "-f", "v0.3.0")
+
+        moved = run_script(
+            repo,
+            ["verify", "v0.3.0", "--expected-sha", first_sha],
+        )
+        self.assertNotEqual(moved.returncode, 0)
+        self.assertIn("moved since selection", moved.stderr)
+
+    def test_publish_plan_records_all_absent_versions(self) -> None:

new file mode 100644
index 0000000..bb3f975
--- /dev/null
+++ b/scripts/test_check_all.py
@@ -0,0 +1,73 @@
+#!/usr/bin/env python3
+"""Exercise gate failure propagation and the release script's gate handoff."""
+
+import importlib.util
+from pathlib import Path
+import subprocess
+import unittest
+from unittest.mock import patch
+
+
+def load(name, path):
+    spec = importlib.util.spec_from_file_location(name, path)
+    module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(module)
+    return module
+
+
+ROOT = Path(__file__).resolve().parent.parent
+gates = load("sdax_check_all", ROOT / "scripts/check-all.py")
+release = load("sdax_release", ROOT / "scripts/release.py")
+
+
+class GateTests(unittest.TestCase):
+    def test_failure_stops_before_later_commands(self):
+        calls = []
+
+        def fail_second(command, **kwargs):
+            calls.append(command)
+            return subprocess.CompletedProcess(command, 23 if len(calls) == 2 else 0)
+
+        with patch.object(gates.subprocess, "run", side_effect=fail_second):
+            self.assertEqual(gates.main([]), 23)
+        self.assertEqual(len(calls), 2)
+
+    def test_no_test_keeps_non_test_release_gates(self):
+        with patch.object(gates.subprocess, "run") as run:
+            run.return_value = subprocess.CompletedProcess([], 0)
+            self.assertEqual(gates.main(["--no-test"]), 0)
+        commands = [call.args[0] for call in run.call_args_list]
+        self.assertFalse(any(c[:2] == ["cargo", "test"] for c in commands))
+        for expected in (
+            "check-architecture.sh", "compile-fail.sh", "check-guide-quotes.sh",
+            "check-consumer-guide.py", "check-package-contents.py",
+            "test_release_selection.py",
+        ):
+            self.assertTrue(any(any(str(a).endswith(expected) for a in c)
+                                for c in commands), expected)
+        self.assertTrue(any(c[:2] == ["cargo", "doc"] for c in commands))
+        self.assertTrue(any(c[:2] == ["cargo", "package"] for c in commands))
+
+    def test_rustdoc_warnings_are_errors_without_losing_existing_flags(self):
+        with patch.dict(gates.os.environ, {"RUSTDOCFLAGS": "--cfg consumer"}):
+            with patch.object(gates.subprocess, "run") as run:
+                run.return_value = subprocess.CompletedProcess([], 0)
+                self.assertEqual(gates.main([]), 0)
+        doc = next(c for c in run.call_args_list if c.args[0][:2] == ["cargo", "doc"])
+        self.assertEqual(doc.kwargs["env"]["RUSTDOCFLAGS"], "--cfg consumer -D warnings")
+
+    def test_release_uses_shared_gates_with_only_explicit_dirty_allowance(self):
+        with patch.object(release, "run") as run:
+            release.run_gates(no_test=False)
+            release.run_gates(no_test=True, allow_dirty=True)
+        self.assertEqual(len(run.call_args_list), 2)
+        first, second = (list(map(str, c.args[0])) for c in run.call_args_list)
+        self.assertTrue(first[1].endswith("scripts/check-all.py"))
+        self.assertNotIn("--allow-dirty", first)
+        self.assertNotIn("--no-test", first)
+        self.assertIn("--allow-dirty", second)
+        self.assertIn("--no-test", second)
+
+
+if __name__ == "__main__":
+    unittest.main()

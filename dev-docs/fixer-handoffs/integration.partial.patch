index 0000000..41c706c
--- /dev/null
+++ b/scripts/check-all.py
@@ -0,0 +1,64 @@
+#!/usr/bin/env python3
+"""Run the shared local, CI and release gates, stopping at the first failure.
+
+Dependencies must already be cached. CI prepares them with cargo fetch --locked.
+--allow-dirty is for a local review or the release script's uncommitted version
+bump; clean release verification omits it. --no-test skips only the Rust suite.
+This command never commits, tags, pushes or publishes.
+"""
+
+import argparse
+import os
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parent.parent
+
+
+def main(argv=None):
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--allow-dirty", action="store_true")
+    parser.add_argument("--no-test", action="store_true")
+    args = parser.parse_args(argv)
+    cargo_flags = ["--locked", "--offline"]
+    commands = [
+        ["cargo", "fmt", "--check"],
+        ["cargo", "metadata", "--format-version", "1", *cargo_flags],
+        ["cargo", "clippy", "--workspace", "--all-targets", *cargo_flags,
+         "--", "-D", "warnings"],
+    ]
+    if not args.no_test:
+        commands.append(["cargo", "test", "--workspace", *cargo_flags])
+    package = ["cargo", "package", "-p", "sdax", *cargo_flags]
+    if args.allow_dirty:
+        package.append("--allow-dirty")
+    commands.extend([
+        package,
+        ["./scripts/check-architecture.sh"],
+        ["./scripts/compile-fail.sh"],
+        ["./scripts/check-guide-quotes.sh"],
+        ["cargo", "doc", "--workspace", "--no-deps", *cargo_flags],
+        [sys.executable, "scripts/check-consumer-guide.py"],
+        [sys.executable, "scripts/check-package-contents.py"],
+        [sys.executable, "scripts/test_release_selection.py"],
+        [sys.executable, "scripts/test_check_all.py"],
+    ])
+    for command in commands:
+        env = os.environ.copy()
+        if command[:2] == ["cargo", "doc"]:
+            env["RUSTDOCFLAGS"] = (env.get("RUSTDOCFLAGS", "") + " -D warnings").strip()
+        print("check: " + " ".join(command), flush=True)
+        result = subprocess.run(
+            command, cwd=ROOT, env=env,
+            stdout=subprocess.DEVNULL if command[:2] == ["cargo", "metadata"] else None,
+        )
+        if result.returncode:
+            print("check: failed: " + " ".join(command), file=sys.stderr)
+            return result.returncode
+    print("All shared checks passed.")
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
